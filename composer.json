{
    "name": "acseo/eshop-ai-tools",
    "description": "Use AI to improve eShop experience",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ACSEO\\EshopAiTools\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Nicolas Potier",
            "email": "nicolas.potier@acseo-conseil.fr"
        }
    ],
    "require": {
        "openai-php/client": "^0.10.1",
        "symfony/http-client": "^7.1",
        "nyholm/psr7": "^1.8",
        "symfony/console": "^7.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^7.1"
    }
}
