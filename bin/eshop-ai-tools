#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';

use Symfony\Component\Console\Application;
use ACSEO\EshopAiTools\Command as Command;

$application = new Application();

$application->add(new Command\TextToTagsCommand());
$application->add(new Command\PicturesToTagsCommand());
$application->add(new Command\TextToDescriptionCommand());
$application->add(new Command\PicturesToDescriptionCommand());
$application->add(new Command\PicturesToProductCommand());

$application->run();